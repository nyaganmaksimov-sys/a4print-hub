{
  "name": "a4print-hub-desktop",
  "version": "1.0.5",
  "description": "Windows desktop shell for A4PRINT HUB",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "check": "node --check main.js && node --check update-preload.js && node --check desktop-nav.js",
    "dist:win": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^35.7.5",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "ru.a4print.hub.desktop",
    "productName": "A4PRINT HUB",
    "artifactName": "A4PRINT-HUB-Setup-${version}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "updates.html",
      "update-preload.js",
      "update-notes.json",
      "package.json",
      "desktop-layout.css",
      "desktop-nav.js"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/nyaganmaksimov-sys/a4print-hub/releases/download/hub-desktop"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  }
}
